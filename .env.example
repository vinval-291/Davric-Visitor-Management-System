# Copy this file to .env and fill in real values (Step 2).
# .env is git-ignored and must never be committed.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Minutes of inactivity before the app signs itself out.
# The reception tablet is a shared device in a public area.
# Set to 0 to disable.
VITE_IDLE_TIMEOUT_MINUTES=30

# Web Push public key, from `npm run vapid`. Safe in the browser.
# The PRIVATE half is a Supabase secret and must never live here.
VITE_VAPID_PUBLIC_KEY=

# Test accounts for `npm run test:security` (Step 14).
# These are the three accounts created in Step 5.
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
TEST_RECEPTION_EMAIL=reception@test.local
TEST_RECEPTION_PASSWORD=
TEST_PA_EMAIL=pa@test.local
TEST_PA_PASSWORD=

# SMTP check for `npm run test:smtp` (local only, never in Vercel).
# Must match what is saved in Supabase > Authentication > Emails.
SMTP_HOST=business16.web-hosting.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
